{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": false,
    "emitDeclarationOnly": false,
    "noEmit": false,
    "module": "ES2020",
    "moduleResolution": "bundler",
    "target": "ES2020",
    "jsx": "react-jsx",
    "rootDir": "./src",
    "outDir": "./dist",
    "isolatedModules": true
  },
  "include": ["src/components", "src/utils", "src/hooks"],
  "exclude": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.stories.ts",
    "**/*.stories.tsx",
    "src/stories",
    "src/icons"
  ]
}
