{
  "name": "eidotter",
  "version": "0.24.1",
  "type": "module",
  "description": "A DOS Themed Design System",
  "main": "./dist/index.umd.js",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.umd.js"
    },
    "./brand": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.umd.js"
    },
    "./styles": "./dist/eidotter.css",
    "./utilities": "./src/styles/dos-utilities.css",
    "./tailwind.preset": "./tailwind.preset.cjs",
    "./tailwind.preset.enhanced": "./tailwind.preset.enhanced.cjs",
    "./fonts.css": "./src/styles/fonts.css",
    "./tokens.css": "./src/styles/tokens.css",
    "./themes/amber-mono.css": "./src/styles/theme.amber-mono.css",
    "./themes/cga-amber.css": "./src/styles/theme.cga-amber.css",
    "./themes/cga-mode4-p0.css": "./src/styles/theme.cga-mode4-p0.css",
    "./themes/cga-mode4-p1.css": "./src/styles/theme.cga-mode4-p1.css",
    "./themes/cga-mode5.css": "./src/styles/theme.cga-mode5.css"
  },
  "files": [
    "dist/index.d.ts",
    "dist/index.es.js",
    "dist/index.umd.js",
    "dist/eidotter.css",
    "dist/components",
    "tailwind.preset.cjs",
    "tailwind.preset.enhanced.cjs",
    "src/styles/fonts.css",
    "src/styles/fonts/Perfect_DOS_VGA_437_Win.ttf",
    "src/styles/fonts/Perfect_DOS_VGA_437_LICENSE.txt",
    "src/styles/fonts/Flexi_IBM_VGA_True.ttf",
    "src/styles/fonts/Flexi_IBM_VGA_LICENSE.txt",
    "src/styles/tokens.css",
    "src/styles/theme.*.css",
    "src/styles/dos-utilities.css",
    "guidelines"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "build-tokens": "node style-dictionary.config.mjs",
    "lint": "eslint src/ --report-unused-disable-directives --max-warnings 0",
    "lint-tokens": "node scripts/lint-token-refs.mjs",
    "check-contrast": "node scripts/check-contrast.mjs",
    "test-a11y": "test-storybook --url http://127.0.0.1:6007 --maxWorkers 2 --no-cache",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o docs",
    "test": "jest",
    "create-component": "ts-node scripts/create-component.ts",
    "sync-to-figma": "ts-node scripts/sync-to-figma.ts",
    "sync-figma-to-swift": "ts-node scripts/sync-figma-to-swift.ts",
    "validate-tokens": "node scripts/validate-tokens.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CinimoDY/eiDotter.git"
  },
  "keywords": [
    "design-system",
    "react",
    "components",
    "ui",
    "typescript",
    "dos",
    "retro",
    "terminal",
    "cga",
    "tailwindcss",
    "accessibility"
  ],
  "author": "CinimoDY",
  "license": "CC-BY-NC-4.0",
  "bugs": {
    "url": "https://github.com/CinimoDY/eiDotter/issues"
  },
  "homepage": "https://cinimody.github.io/eiDotter",
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "tailwindcss": "^3.0.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@figma/plugin-typings": "^1.107.0-beta.2",
    "@figma/rest-api-spec": "^0.38.0",
    "@storybook/addon-a11y": "^10.2.7",
    "@storybook/addon-designs": "^11.1.2",
    "@storybook/addon-docs": "^10.2.7",
    "@storybook/addon-links": "^10.2.7",
    "@storybook/react": "^10.2.7",
    "@storybook/react-vite": "^10.2.7",
    "@storybook/test-runner": "^0.24.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/glob": "^8.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.4.27",
    "axe-playwright": "^2.2.2",
    "chromatic": "^16.2.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.3.1",
    "eslint": "^10.0.3",
    "eslint-plugin-react-hooks": "^7.0.1",
    "figma-js": "^1.16.1-0",
    "gh-pages": "^6.3.0",
    "glob": "^13.0.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.0.2",
    "leva": "^0.10.1",
    "postcss": "^8.5.8",
    "remark-gfm": "^4.0.1",
    "storybook": "^10.2.7",
    "style-dictionary": "^5.1.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "tailwindcss-react-aria-components": "^2.0.1",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.54.0",
    "vite": "^8.0.10"
  },
  "dependencies": {
    "pixelarticons": "^2.1.0",
    "react-aria": "^3.47.0",
    "react-aria-components": "^1.16.0",
    "react-stately": "^3.45.0"
  }
}
