# Eidotter Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env files with real credentials

# Figma Integration (for sync-to-figma script)
# WARNING: These values are NOT needed for Storybook builds
# The Storybook build process filters out TOKEN/SECRET/KEY vars
#
# For secure token management, use 1Password CLI:
# FIGMA_ACCESS_TOKEN=$(op read "op://Personal/Figma API Key/credential")
FIGMA_ACCESS_TOKEN=
FIGMA_FILE_KEY=your-figma-file-key-here

# Phase 2+ multi-platform DS file keys (set after each platform's Figma file lands).
# eiDotter Foundation library — T1 primitives + T3 dimensions + T4 effect params.
# Subscribed-to by all per-platform DS files. Created 2026-05-08 in Phase 2.
FIGMA_FOUNDATION_KEY=KoGTFX8INOAjFaOKPXnSlX
# eiDotter Web DS — Phase 3a: subscribes to Foundation; web T2 (120 vars: 21 aliased to Foundation).
# Component sets pending (Phase 3a follow-up).
FIGMA_WEB_DS_KEY=iohPpta7n73wCcP5xbsaJU
# eiDotter iOS DS — Phase 3b in-place migration of iOS 26.
FIGMA_IOS_DS_KEY=TEnlcIgXrB3akHvtjMy3po
# eiDotter macOS DS — Phase 3c in-place migration of macOS 26.
FIGMA_MACOS_DS_KEY=peVTIvO9oDzynkPXhQo0W8
# eiDotter tvOS DS — Phase 3d (split into separate plan; gated on Spacewar tvOS access).
FIGMA_TVOS_DS_KEY=
