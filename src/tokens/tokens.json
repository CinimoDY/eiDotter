{
  "$metadata": {
    "tokenSetOrder": [
      "global/global",
      "color-primitive/value",
      "typography-primitives/value",
      "component/button",
      "numbers/mode-1"
    ]
  },
  "global/global": {
    "colors": {
      "dos": {
        "yellow": {
          "$value": "#ffb000",
          "$type": "color"
        },
        "black": {
          "$value": "#000000",
          "$type": "color"
        },
        "dim": {
          "$value": "#ffb000b3",
          "$type": "color"
        },
        "bright": {
          "$value": "#ffd700",
          "$type": "color"
        },
        "border": {
          "$value": "#ffb000",
          "$type": "color"
        }
      },
      "system": {
        "background": {
          "$value": "{global/global.colors.dos.black}",
          "$type": "color"
        },
        "foreground": {
          "$value": "{global/global.colors.dos.yellow}",
          "$type": "color"
        },
        "border": {
          "$value": "{global/global.colors.dos.border}",
          "$type": "color"
        },
        "title": {
          "background": {
            "$value": "{global/global.colors.dos.yellow}",
            "$type": "color"
          },
          "foreground": {
            "$value": "{global/global.colors.dos.black}",
            "$type": "color"
          }
        },
        "link": {
          "default": {
            "$value": "{global/global.colors.dos.yellow}",
            "$type": "color"
          },
          "hover": {
            "$value": "{global/global.colors.dos.bright}",
            "$type": "color"
          },
          "dim": {
            "$value": "{global/global.colors.dos.dim}",
            "$type": "color"
          }
        },
        "primary-glow": {
          "$value": "#ffb00080",
          "$type": "color"
        }
      }
    },
    "typography": {
      "fonts": {
        "dos": {
          "$value": "Perfect DOS VGA 437",
          "$type": "text"
        },
        "fallback": {
          "$value": "Consolas",
          "$type": "text"
        }
      },
      "weights": {
        "regular": {
          "$value": 400,
          "$type": "number"
        },
        "bold": {
          "$value": 700,
          "$type": "number"
        }
      },
      "sizes": {
        "base": {
          "$value": 16,
          "$type": "number"
        },
        "small": {
          "$value": 14,
          "$type": "number"
        },
        "large": {
          "$value": 18,
          "$type": "number"
        },
        "title": {
          "$value": 16,
          "$type": "number"
        }
      },
      "line-height": {
        "base": {
          "$value": 1.5,
          "$type": "number"
        },
        "tight": {
          "$value": 1.2,
          "$type": "number"
        },
        "single": {
          "$value": 1,
          "$type": "number"
        }
      },
      "letter-spacing": {
        "normal": {
          "$type": "number"
        },
        "wide": {
          "$value": 0.8,
          "$type": "number"
        }
      }
    },
    "spacing": {
      "unit": {
        "$value": 16,
        "$type": "number"
      },
      "title": {
        "height": {
          "$value": 24,
          "$type": "number"
        }
      },
      "xxs": {
        "$value": 4,
        "$type": "number"
      },
      "xs": {
        "$value": 8,
        "$type": "number"
      },
      "sm": {
        "$value": 12,
        "$type": "number"
      },
      "md": {
        "$value": 16,
        "$type": "number"
      },
      "lg": {
        "$value": 24,
        "$type": "number"
      },
      "xl": {
        "$value": 32,
        "$type": "number"
      }
    }
  },
  "color-primitive/value": {
    "light": {
      "gray": {
        "50": { "$value": "#ffffff", "$type": "color" },
        "100": { "$value": "#f6f7f8", "$type": "color" },
        "600": { "$value": "#66696d", "$type": "color" },
        "800": { "$value": "#191919bf", "$type": "color" }
      }
    },
    "dark": {
      "gray": {
        "50": { "$value": "#1d1d1d", "$type": "color" },
        "75": { "$value": "#262626", "$type": "color" }
      }
    }
  },
  "typography-primitives/value": {
    "font-family": {
      "sans": { "$value": "{global/global.typography.fonts.dos}", "$type": "text" },
      "mono": { "$value": "{global/global.typography.fonts.fallback}", "$type": "text" }
    },
    "weight": {
      "regular": { "$value": "{global/global.typography.weights.regular}", "$type": "number" },
      "bold": { "$value": "{global/global.typography.weights.bold}", "$type": "number" }
    },
    "size-desktop": {
      "100": { "$value": 14, "$type": "number" },
      "200": { "$value": 16, "$type": "number" },
      "300": { "$value": 18, "$type": "number" }
    }
  },
  "component/button": {
    "height": { "$value": 40, "$type": "number" },
    "min-width": { "$value": 180, "$type": "number" },
    "padding": {
      "x": { "$value": "{global/global.spacing.md}", "$type": "number" },
      "y": { "$value": "{global/global.spacing.xs}", "$type": "number" }
    }
  },
  "numbers/mode-1": {
    "corner": {
      "none": { "$value": 0, "$type": "number" },
      "s": { "$value": 4, "$type": "number" },
      "m": { "$value": 8, "$type": "number" }
    },
    "space": {
      "xxxs": { "$value": 2, "$type": "number" },
      "xxs": { "$value": 4, "$type": "number" },
      "xs": { "$value": 8, "$type": "number" }
    }
  }
}