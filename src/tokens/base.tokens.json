{
  "$description": "Eidotter Design System - Base Tokens (DTCG Format)",

  "color": {
    "$description": "Amber monochrome palette (default) - use themes for CGA color variant",
    "cga": {
      "$type": "color",
      "black":         { "$value": "#020003", "$description": "Amber monochrome - darkest" },
      "blue":          { "$value": "#2C1203", "$description": "Amber monochrome" },
      "green":         { "$value": "#411F06", "$description": "Amber monochrome" },
      "cyan":          { "$value": "#552D0A", "$description": "Amber monochrome" },
      "red":           { "$value": "#65360C", "$description": "Amber monochrome" },
      "magenta":       { "$value": "#713E0D", "$description": "Amber monochrome" },
      "brown":         { "$value": "#5F340E", "$description": "Amber monochrome" },
      "lightGray":     { "$value": "#B87C1A", "$description": "Amber monochrome" },
      "darkGray":      { "$value": "#010103", "$description": "Amber monochrome - near black" },
      "brightBlue":    { "$value": "#C38A23", "$description": "Amber monochrome" },
      "brightGreen":   { "$value": "#CB9529", "$description": "Amber monochrome" },
      "brightCyan":    { "$value": "#D4A030", "$description": "Amber monochrome" },
      "brightRed":     { "$value": "#DCA934", "$description": "Amber monochrome" },
      "brightMagenta": { "$value": "#DDB030", "$description": "Amber monochrome" },
      "yellow":        { "$value": "#E5B936", "$description": "Amber monochrome - accent" },
      "white":         { "$value": "#BA8225", "$description": "Amber monochrome" },
      "amber":         { "$value": "#FFB000", "$description": "P3 phosphor amber (602nm)" },
      "amberBright":   { "$value": "#FDCA9F", "$description": "P3 phosphor amber bright" },
      "amberDim":      { "$value": "#9A5700", "$description": "P3 phosphor amber dim" },
      "amberGlow":     { "$value": "#FFB00080", "$description": "Amber glow at 50% opacity" }
    },
    "semantic": {
      "$type": "color",
      "$description": "Semantic color aliases - override in theme files",
      "background": {
        "primary":   { "$value": "{color.cga.black}" },
        "secondary": { "$value": "{color.cga.darkGray}" },
        "accent":    { "$value": "{color.cga.amber}" }
      },
      "text": {
        "primary":   { "$value": "{color.cga.lightGray}" },
        "secondary": { "$value": "{color.cga.black}" },
        "accent":    { "$value": "{color.cga.yellow}" },
        "disabled":  { "$value": "{color.cga.darkGray}" }
      },
      "border": {
        "default":  { "$value": "{color.cga.lightGray}" },
        "focus":    { "$value": "{color.cga.yellow}" },
        "hover":    { "$value": "{color.cga.white}" },
        "disabled": { "$value": "{color.cga.darkGray}" }
      },
      "link": {
        "default": { "$value": "{color.cga.brightCyan}" },
        "hover":   { "$value": "{color.cga.white}" },
        "active":  { "$value": "{color.cga.cyan}" },
        "visited": { "$value": "{color.cga.magenta}" }
      },
      "status": {
        "success": { "$value": "{color.cga.brightGreen}" },
        "warning": { "$value": "{color.cga.yellow}" },
        "error":   { "$value": "{color.cga.brightRed}" },
        "info":    { "$value": "{color.cga.brightCyan}" }
      },
      "alert": {
        "$description": "Alert component background colors",
        "info":    { "$value": "#1a2535", "$description": "Cool dark blue-gray for info alerts" },
        "success": { "$value": "#0a2015", "$description": "Dark green for success alerts" },
        "warning": { "$value": "#352800", "$description": "Dark amber for warning alerts" },
        "error":   { "$value": "#430000", "$description": "Dark red for error alerts" }
      }
    }
  },

  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "primary":  { "$value": ["JetBrains Mono", "JetBrainsMono Nerd Font", "Consolas", "Monaco", "monospace"], "$description": "JetBrains Mono with Nerd Font fallback" },
      "fallback": { "$value": ["Consolas", "Monaco", "Courier New", "monospace"], "$description": "System monospace fallback" }
    },
    "fontSize": {
      "$type": "dimension",
      "xs":   { "$value": "12px" },
      "sm":   { "$value": "14px" },
      "base": { "$value": "16px" },
      "lg":   { "$value": "18px" },
      "xl":   { "$value": "20px" },
      "2xl":  { "$value": "24px" },
      "3xl":  { "$value": "30px" },
      "4xl":  { "$value": "36px" }
    },
    "fontWeight": {
      "$type": "fontWeight",
      "regular":  { "$value": 400 },
      "semibold": { "$value": 600 },
      "bold":     { "$value": 700 }
    },
    "lineHeight": {
      "$type": "number",
      "tight":  { "$value": 1.2 },
      "normal": { "$value": 1.5 },
      "loose":  { "$value": 1.8 }
    }
  },

  "spacing": {
    "$type": "dimension",
    "$description": "8px base grid spacing scale",
    "0":  { "$value": "0px" },
    "1":  { "$value": "4px" },
    "2":  { "$value": "8px" },
    "3":  { "$value": "12px" },
    "4":  { "$value": "16px" },
    "5":  { "$value": "20px" },
    "6":  { "$value": "24px" },
    "8":  { "$value": "32px" },
    "10": { "$value": "40px" },
    "12": { "$value": "48px" },
    "16": { "$value": "64px" }
  },

  "borderRadius": {
    "$type": "dimension",
    "$description": "DOS aesthetic: minimal or no rounding",
    "none": { "$value": "0px" },
    "sm":   { "$value": "2px" },
    "base": { "$value": "4px" }
  },

  "borderWidth": {
    "$type": "dimension",
    "thin":   { "$value": "1px" },
    "medium": { "$value": "2px" },
    "thick":  { "$value": "4px" }
  },

  "shadow": {
    "$type": "shadow",
    "$description": "DOS-style shadows and phosphor glow effects",
    "none": {
      "$value": {
        "offsetX": "0px",
        "offsetY": "0px",
        "blur": "0px",
        "spread": "0px",
        "color": "#00000000"
      }
    },
    "drop": {
      "$value": {
        "offsetX": "2px",
        "offsetY": "2px",
        "blur": "0px",
        "spread": "0px",
        "color": "#000000"
      },
      "$description": "Hard drop shadow, DOS window style"
    },
    "glowXs": {
      "$value": {
        "offsetX": "0px",
        "offsetY": "0px",
        "blur": "8px",
        "spread": "0px",
        "color": "#FFB00080"
      },
      "$description": "Extra small phosphor glow (subtle hover)"
    },
    "glowSm": {
      "$value": {
        "offsetX": "0px",
        "offsetY": "0px",
        "blur": "10px",
        "spread": "0px",
        "color": "#FFB00080"
      },
      "$description": "Small phosphor glow (button hover)"
    },
    "glowMd": {
      "$value": {
        "offsetX": "0px",
        "offsetY": "0px",
        "blur": "20px",
        "spread": "0px",
        "color": "#FFB00080"
      },
      "$description": "Medium phosphor glow (container/card)"
    },
    "glowLg": {
      "$value": {
        "offsetX": "0px",
        "offsetY": "0px",
        "blur": "30px",
        "spread": "0px",
        "color": "#FFB00080"
      },
      "$description": "Large phosphor glow (emphasis)"
    }
  },

  "duration": {
    "$type": "duration",
    "$description": "Animation durations - DOS is instant, but allow subtle transitions",
    "instant":  { "$value": "0ms" },
    "fast":     { "$value": "100ms" },
    "normal":   { "$value": "200ms" },
    "slow":     { "$value": "400ms" },
    "powerOff": { "$value": "400ms", "$description": "CRT power-off animation" },
    "powerOn":  { "$value": "600ms", "$description": "CRT power-on animation (phosphor warm-up)" }
  },

  "opacity": {
    "$type": "number",
    "$description": "Opacity scale for overlays, disabled states, and effects",
    "0":   { "$value": 0, "$description": "Fully transparent" },
    "10":  { "$value": 0.1, "$description": "Subtle hover overlays" },
    "25":  { "$value": 0.25, "$description": "Light overlays" },
    "50":  { "$value": 0.5, "$description": "Disabled states, medium overlays" },
    "75":  { "$value": 0.75, "$description": "Heavy overlays" },
    "80":  { "$value": 0.8, "$description": "Modal backdrop" },
    "100": { "$value": 1, "$description": "Fully opaque" }
  },

  "zIndex": {
    "$type": "number",
    "$description": "Z-index scale for layering UI elements",
    "base":     { "$value": 0, "$description": "Default stacking context" },
    "dropdown": { "$value": 1000, "$description": "Dropdowns and popovers" },
    "sticky":   { "$value": 1020, "$description": "Sticky headers and navs" },
    "fixed":    { "$value": 1030, "$description": "Fixed position elements" },
    "modal":    { "$value": 1040, "$description": "Modal dialogs" },
    "popover":  { "$value": 1050, "$description": "Popovers above modals" },
    "tooltip":  { "$value": 1060, "$description": "Tooltips (topmost)" }
  },

  "focusRing": {
    "$description": "Focus ring styles for accessibility",
    "width":  { "$type": "dimension", "$value": "2px", "$description": "Focus ring thickness" },
    "offset": { "$type": "dimension", "$value": "2px", "$description": "Gap between element and ring" },
    "color":  { "$type": "color", "$value": "{color.cga.yellow}", "$description": "Focus ring color (accent)" }
  },

  "effects": {
    "$description": "CRT and overlay effect colors",
    "overlay": {
      "$type": "color",
      "$value": "rgba(0, 0, 0, 0.8)",
      "$description": "Modal/dialog backdrop overlay"
    },
    "scanlineLight": {
      "$type": "color",
      "$value": "rgba(255, 176, 0, 0.05)",
      "$description": "CRT scanline light band"
    },
    "scanlineDark": {
      "$type": "color",
      "$value": "rgba(255, 176, 0, 0.02)",
      "$description": "CRT scanline dark band"
    },
    "vignetteGlow": {
      "$type": "color",
      "$value": "rgba(255, 176, 0, 0.12)",
      "$description": "Inner screen glow vignette"
    },
    "vignetteEdge": {
      "$type": "color",
      "$value": "rgba(0, 0, 0, 0.3)",
      "$description": "Vignette edge darkening"
    },
    "vignetteCorner": {
      "$type": "color",
      "$value": "rgba(0, 0, 0, 0.5)",
      "$description": "Vignette corner darkening"
    },
    "screenTint": {
      "$type": "color",
      "$value": "rgba(255, 176, 0, 0.1)",
      "$description": "Subtle amber screen tint"
    },
    "dropShadow": {
      "$type": "color",
      "$value": "rgba(0, 0, 0, 0.5)",
      "$description": "Terminal window drop shadow"
    },
    "phosphorGlow": {
      "$type": "color",
      "$value": "rgba(255, 176, 0, 0.12)",
      "$description": "Phosphor bloom/bleeding glow for CRT effects"
    },
    "crtBackground": {
      "$type": "color",
      "$value": "#060300",
      "$description": "Dark warm-black for CRT screen (not pure black)"
    }
  }
}
