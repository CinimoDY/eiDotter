      "brown":         { "$value": "#5F340E", "$description": "Amber monochrome" },
      "lightGray":     { "$value": "#B87C1A", "$description": "Amber monochrome" },
      "darkGray":      { "$value": "#010103", "$description": "Amber monochrome - near black" },
      "brightBlue":    { "$value": "#C38A23", "$description": "Amber monochrome" },
      "brightGreen":   { "$value": "#CB9529", "$description": "Amber monochrome" },
      "brightCyan":    { "$value": "#D4A030", "$description": "Amber monochrome" },
