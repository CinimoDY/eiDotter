{
  "color": {
    "semantic": {
      "$type": "color",
      "$description": "Semantic color aliases - override in theme files",
      "background": {
        "primary":   { "$value": "{color.cga.black}" },
        "secondary": { "$value": "{color.cga.darkGray}" },
        "accent":    { "$value": "{color.cga.amber}" },
        "tertiary":  { "$value": "{color.cga.darkGray}", "$description": "UTI-tier role (DMNC-922). Third surface level; same value as `secondary` for now in the dark DOS theme — diverges in the light theme." },
        "brand":     { "$value": "{color.cga.amber}", "$description": "UTI-tier role (DMNC-922). Amber fill surface (e.g. primary button background). Pair with `text.onBrand`." },
        "brandBright": { "$value": "{color.cga.amberBright}", "$description": "DMNC-1059: bright-amber brand emphasis surface — hover/active/selected peaks (e.g. primary button :active fill, active TimelineNode marker, InlineLink :active). Brand-locked amber across themes." },
        "brandDim":  { "$value": "{color.cga.amberDim}", "$description": "DMNC-1059: dim-amber brand surface — low-emphasis fills/headers (e.g. Card header, timeline axis, default TimelineNode marker). Brand-locked amber across themes." },
        "error":     { "$value": "{color.cga-true.red}", "$description": "UTI-tier functional role (DMNC-922). Honest red solid fill for destructive controls (e.g. destructive button background). Pair with a light foreground." },
        "success":   { "$value": "{color.cga-true.green}", "$description": "UTI-tier functional role (DMNC-922). Honest green solid fill." }
      },
      "text": {
        "primary":   { "$value": "{color.cga.lightGray}" },
        "secondary": { "$value": "{color.cga.black}" },
        "accent":    { "$value": "{color.cga.yellow}" },
        "disabled":  { "$value": "{color.cga.darkGray}" },
        "muted":     { "$value": "{color.cga.amberDim}", "$description": "Muted supplementary text — timestamps, counts, footnotes. T10 handoff: dedicated amber-dim hex (in-family with primary), not brown; no opacity coupling." },
        "tertiary":  { "$value": "{color.cga.amberDim}", "$description": "UTI-tier role (DMNC-922). Third-emphasis text; same value as `muted` for now — `muted` is retained as its DOS-semantic alias. New components should prefer the tier name." },
        "brand":     { "$value": "{color.cga.amber}", "$description": "UTI-tier role (DMNC-922). The honest phosphor-amber text role — the value ~30 components currently paint with as raw `--color-cga-amber`. The DMNC-1059 sweep migrates them here so amber text re-themes." },
        "brandBright": { "$value": "{color.cga.amberBright}", "$description": "DMNC-1059: bright-amber brand emphasis text — hover/active peaks (e.g. Checkbox hover glyph, link-button hover, Button :active label). Brand-locked amber across themes." },
        "onBrand":   { "$value": "{color.cga.black}", "$description": "UTI-tier role (DMNC-922). Text/icon sitting on a brand-amber fill (e.g. primary button label)." },
        "error":     { "$value": "{color.cga-true.redBright}", "$description": "UTI-tier functional role (DMNC-922). Bright honest red (#FF5555) — readable as error TEXT on the dark CRT background (the solid `cga-true.red` #AA0000 is only ~2.3:1 as text). For red FILLS use `background.error`/`border.error` (solid #AA0000)." },
        "warning":   { "$value": "{color.cga.amber}", "$description": "UTI-tier functional role (DMNC-922). Warning = amber in the DOS palette (amber IS the caution hue); intentionally not a separate yellow." },
        "success":   { "$value": "{color.cga-true.green}", "$description": "UTI-tier functional role (DMNC-922). Honest CGA green (#00AA00), theme-invariant." },
        "info":      { "$value": "{color.cga-true.cyan}", "$description": "UTI-tier functional role (DMNC-922). Honest CGA cyan (#00AAAA), theme-invariant." },
        "white":     { "$value": "{color.cga-true.white}", "$description": "UTI-tier role (DMNC-922). Theme-invariant light foreground for functional/dark fills (e.g. white-on-red destructive button text). Not for body text on the dark CRT background." }
      },
      "border": {
        "default":  { "$value": "{color.cga.lightGray}" },
        "focus":    { "$value": "{color.cga.yellow}" },
        "hover":    { "$value": "{color.cga.white}" },
        "disabled": { "$value": "{color.cga.darkGray}" },
        "brand":    { "$value": "{color.cga.amber}", "$description": "UTI-tier role (DMNC-922). Amber border (active/selected emphasis)." },
        "brandBright": { "$value": "{color.cga.amberBright}", "$description": "DMNC-1059: bright-amber brand emphasis border — hover/active/selected peaks (e.g. primary button :active, active TimelineNode marker). Brand-locked amber across themes." },
        "brandDim":  { "$value": "{color.cga.amberDim}", "$description": "DMNC-1059: dim-amber brand border — low-emphasis markers (e.g. default TimelineNode marker). Brand-locked amber across themes." },
        "error":    { "$value": "{color.cga-true.red}", "$description": "UTI-tier functional role (DMNC-922). Honest red border for destructive/error controls." },
        "success":  { "$value": "{color.cga-true.green}", "$description": "UTI-tier functional role (DMNC-922). Honest green border." }
      },
      "link": {
        "default": { "$value": "{color.cga.brightCyan}" },
        "hover":   { "$value": "{color.cga.white}" },
        "active":  { "$value": "{color.cga.cyan}" },
        "visited": { "$value": "{color.cga.magenta}" }
      },
      "status": {
        "success": { "$value": "{color.cga.brightGreen}" },
        "warning": { "$value": "{color.cga.yellow}" },
        "error":   { "$value": "{color.cga.brightRed}" },
        "info":    { "$value": "{color.cga.brightCyan}" }
      },
      "alert": {
        "$description": "Alert component background colors",
        "info":    { "$value": "#1F2228", "$description": "Warm dark blue for info alerts" },
        "success": { "$value": "#122010", "$description": "Warm dark green for success alerts" },
        "warning": { "$value": "#352800", "$description": "Dark amber for warning alerts" },
        "error":   { "$value": "#430500", "$description": "Warm dark red for error alerts" }
      },
      "glow": {
        "$description": "Themeable phosphor glow colours for functional emphasis (hover/active blooms). amber-mono remaps these to amber so the default theme stays monochrome; colour themes keep the honest hue.",
        "error": { "$value": "{color.cga.redGlow}", "$description": "DMNC-1059: destructive/error hover-glow. Honest red bloom under colour themes; amber under the default amber-mono theme." }
      }
    }
  },

  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "primary":  { "$value": ["Perfect DOS VGA 437", "monospace"], "$description": "Perfect DOS VGA 437 by Zeh Fernando (free-for-any-use; ships with bundled LICENSE.txt). Pixel-perfect-vector TTF — every glyph outline is axis-aligned, scales cleanly to any size. The `monospace` fallback preserves DOS aesthetic on @font-face failure." },
      "fallback": { "$value": ["monospace"], "$description": "Bare `monospace` stack — fail-loud diagnostic counterpart to `primary`. Compose with `primary` when consumers want strict Perfect-DOS-or-nothing rendering." }
    },
    "fontSize": {
      "$type": "dimension",
      "$description": "Synced from eiDotter DS V.37 Figma typography variables",
      "text-xs":      { "$value": "1.125rem",  "$description": "18px — smallest body text" },
      "text-sm":      { "$value": "1.25rem",   "$description": "20px — secondary body text" },
      "text-md":      { "$value": "1.375rem",  "$description": "22px — default body text" },
      "text-lg":      { "$value": "1.5rem",    "$description": "24px — large body text" },
      "text-xl":      { "$value": "1.625rem",  "$description": "26px — extra large body text" },
      "display-xs":   { "$value": "1.875rem",  "$description": "30px — smallest heading" },
      "display-sm":   { "$value": "2.25rem",   "$description": "36px — small heading" },
      "display-md":   { "$value": "2.625rem",  "$description": "42px — medium heading" },
      "display-lg":   { "$value": "3.5rem",    "$description": "56px — large heading" },
      "display-xl":   { "$value": "4.125rem",  "$description": "66px — extra large heading" },
      "display-2xl":  { "$value": "4.875rem",  "$description": "78px — hero heading" }
    },
    "fontWeight": {
      "$type": "fontWeight",
      "$description": "Flexi IBM VGA True is a single-weight bitmap-style font. All weight tokens resolve to 400 — authentic DOS had no bold variant (emphasis was color, uppercase, or inverse video). Aliases kept for backward compatibility.",
      "regular":  { "$value": 400 },
      "semibold": { "$value": 400 },
      "bold":     { "$value": 400 }
    },
    "lineHeight": {
      "$type": "dimension",
      "$description": "Per-size line heights synced from eiDotter DS V.37 Figma",
      "text-xs":      { "$value": "1.125rem",  "$description": "18px" },
      "text-sm":      { "$value": "1.25rem",   "$description": "20px" },
      "text-md":      { "$value": "1.5rem",    "$description": "24px" },
      "text-lg":      { "$value": "1.75rem",   "$description": "28px" },
      "text-xl":      { "$value": "1.875rem",  "$description": "30px" },
      "display-xs":   { "$value": "2rem",      "$description": "32px" },
      "display-sm":   { "$value": "2.375rem",  "$description": "38px" },
      "display-md":   { "$value": "2.75rem",   "$description": "44px" },
      "display-lg":   { "$value": "3.75rem",   "$description": "60px" },
      "display-xl":   { "$value": "4.5rem",    "$description": "72px" },
      "display-2xl":  { "$value": "5.625rem",  "$description": "90px" }
    }
  },

  "spacing": {
    "$type": "dimension",
    "$description": "8px base grid spacing scale",
    "0":  { "$value": "0px" },
    "1":  { "$value": "4px" },
    "2":  { "$value": "8px" },
    "3":  { "$value": "12px" },
    "4":  { "$value": "16px" },
    "5":  { "$value": "20px" },
    "6":  { "$value": "24px" },
    "8":  { "$value": "32px" },
    "10": { "$value": "40px" },
    "12": { "$value": "48px" },
    "16": { "$value": "64px" }
  },

  "borderRadius": {
    "$type": "dimension",
    "$description": "DOS aesthetic: minimal or no rounding",
    "none": { "$value": "0px" },
    "sm":   { "$value": "2px" },
    "base": { "$value": "4px" }
  },

  "borderWidth": {
    "$type": "dimension",
    "thin":   { "$value": "1px" },
    "medium": { "$value": "2px" },
    "thick":  { "$value": "4px" }
  },

  "shadow": {
    "$type": "shadow",
    "$description": "DOS-style shadows and phosphor glow effects",
    "none": {
      "$value": {
        "offsetX": "0px",
        "offsetY": "0px",
        "blur": "0px",
        "spread": "0px",
        "color": "#00000000"
      }
    },
    "drop": {
      "$value": {
        "offsetX": "2px",
        "offsetY": "2px",
        "blur": "0px",
        "spread": "0px",
        "color": "#080500"
      },
      "$description": "Hard drop shadow, DOS window style (amber-warm near-black)"
    },
    "glowXs": {
      "$value": {
        "offsetX": "0px",
        "offsetY": "0px",
        "blur": "8px",
        "spread": "0px",
        "color": "#FFB00080"
      },
      "$description": "Extra small phosphor glow (subtle hover)"
    },
    "glowSm": {
      "$value": {
        "offsetX": "0px",
        "offsetY": "0px",
        "blur": "10px",
        "spread": "0px",
        "color": "#FFB00080"
      },
      "$description": "Small phosphor glow (button hover)"
    },
    "glowMd": {
      "$value": {
        "offsetX": "0px",
        "offsetY": "0px",
        "blur": "20px",
        "spread": "0px",
        "color": "#FFB00080"
      },
      "$description": "Medium phosphor glow (container/card)"
    },
    "glowLg": {
      "$value": {
        "offsetX": "0px",
        "offsetY": "0px",
        "blur": "30px",
        "spread": "0px",
        "color": "#FFB00080"
      },
      "$description": "Large phosphor glow (emphasis)"
    },
    "glowXsRed": {
      "$value": { "offsetX": "0px", "offsetY": "0px", "blur": "8px", "spread": "0px", "color": "#FF555580" },
      "$description": "Extra small red phosphor glow"
    },
    "glowSmRed": {
      "$value": { "offsetX": "0px", "offsetY": "0px", "blur": "10px", "spread": "0px", "color": "#FF555580" },
      "$description": "Small red phosphor glow"
    },
    "glowMdRed": {
      "$value": { "offsetX": "0px", "offsetY": "0px", "blur": "20px", "spread": "0px", "color": "#FF555580" },
      "$description": "Medium red phosphor glow"
    },
    "glowLgRed": {
      "$value": { "offsetX": "0px", "offsetY": "0px", "blur": "30px", "spread": "0px", "color": "#FF555580" },
      "$description": "Large red phosphor glow"
    },
    "glowXsGreen": {
      "$value": { "offsetX": "0px", "offsetY": "0px", "blur": "8px", "spread": "0px", "color": "#55FF5580" },
      "$description": "Extra small green phosphor glow"
    },
    "glowSmGreen": {
      "$value": { "offsetX": "0px", "offsetY": "0px", "blur": "10px", "spread": "0px", "color": "#55FF5580" },
      "$description": "Small green phosphor glow"
    },
    "glowMdGreen": {
      "$value": { "offsetX": "0px", "offsetY": "0px", "blur": "20px", "spread": "0px", "color": "#55FF5580" },
      "$description": "Medium green phosphor glow"
    },
    "glowLgGreen": {
      "$value": { "offsetX": "0px", "offsetY": "0px", "blur": "30px", "spread": "0px", "color": "#55FF5580" },
      "$description": "Large green phosphor glow"
    },
    "glowXsCyan": {
      "$value": { "offsetX": "0px", "offsetY": "0px", "blur": "8px", "spread": "0px", "color": "#55FFFF80" },
      "$description": "Extra small cyan phosphor glow"
    },
    "glowSmCyan": {
      "$value": { "offsetX": "0px", "offsetY": "0px", "blur": "10px", "spread": "0px", "color": "#55FFFF80" },
      "$description": "Small cyan phosphor glow"
    },
    "glowMdCyan": {
      "$value": { "offsetX": "0px", "offsetY": "0px", "blur": "20px", "spread": "0px", "color": "#55FFFF80" },
      "$description": "Medium cyan phosphor glow"
    },
    "glowLgCyan": {
      "$value": { "offsetX": "0px", "offsetY": "0px", "blur": "30px", "spread": "0px", "color": "#55FFFF80" },
      "$description": "Large cyan phosphor glow"
    },
    "glowXsMagenta": {
      "$value": { "offsetX": "0px", "offsetY": "0px", "blur": "8px", "spread": "0px", "color": "#FF55FF80" },
      "$description": "Extra small magenta phosphor glow"
    },
    "glowSmMagenta": {
      "$value": { "offsetX": "0px", "offsetY": "0px", "blur": "10px", "spread": "0px", "color": "#FF55FF80" },
      "$description": "Small magenta phosphor glow"
    },
    "glowMdMagenta": {
      "$value": { "offsetX": "0px", "offsetY": "0px", "blur": "20px", "spread": "0px", "color": "#FF55FF80" },
      "$description": "Medium magenta phosphor glow"
    },
    "glowLgMagenta": {
      "$value": { "offsetX": "0px", "offsetY": "0px", "blur": "30px", "spread": "0px", "color": "#FF55FF80" },
      "$description": "Large magenta phosphor glow"
    },
    "glowXsBlue": {
      "$value": { "offsetX": "0px", "offsetY": "0px", "blur": "8px", "spread": "0px", "color": "#5555FF80" },
      "$description": "Extra small blue phosphor glow"
    },
    "glowSmBlue": {
      "$value": { "offsetX": "0px", "offsetY": "0px", "blur": "10px", "spread": "0px", "color": "#5555FF80" },
      "$description": "Small blue phosphor glow"
    },
    "glowMdBlue": {
      "$value": { "offsetX": "0px", "offsetY": "0px", "blur": "20px", "spread": "0px", "color": "#5555FF80" },
      "$description": "Medium blue phosphor glow"
    },
    "glowLgBlue": {
      "$value": { "offsetX": "0px", "offsetY": "0px", "blur": "30px", "spread": "0px", "color": "#5555FF80" },
      "$description": "Large blue phosphor glow"
    },
    "glowXsWhite": {
      "$value": { "offsetX": "0px", "offsetY": "0px", "blur": "8px", "spread": "0px", "color": "#FFFFFF80" },
      "$description": "Extra small white phosphor glow"
    },
    "glowSmWhite": {
      "$value": { "offsetX": "0px", "offsetY": "0px", "blur": "10px", "spread": "0px", "color": "#FFFFFF80" },
      "$description": "Small white phosphor glow"
    },
    "glowMdWhite": {
      "$value": { "offsetX": "0px", "offsetY": "0px", "blur": "20px", "spread": "0px", "color": "#FFFFFF80" },
      "$description": "Medium white phosphor glow"
    },
    "glowLgWhite": {
      "$value": { "offsetX": "0px", "offsetY": "0px", "blur": "30px", "spread": "0px", "color": "#FFFFFF80" },
      "$description": "Large white phosphor glow"
    }
  },

  "duration": {
    "$type": "duration",
    "$description": "Animation durations - DOS is instant, but allow subtle transitions",
    "instant":  { "$value": "0ms" },
    "fast":     { "$value": "100ms" },
    "normal":   { "$value": "200ms" },
    "slow":     { "$value": "400ms" },
    "powerOff": { "$value": "400ms", "$description": "CRT power-off animation" },
    "powerOn":  { "$value": "600ms", "$description": "CRT power-on animation (phosphor warm-up)" }
  },

  "opacity": {
    "$type": "number",
    "$description": "Opacity scale for overlays, disabled states, and effects",
    "0":   { "$value": 0, "$description": "Fully transparent" },
    "10":  { "$value": 0.1, "$description": "Subtle hover overlays" },
    "25":  { "$value": 0.25, "$description": "Light overlays" },
    "50":  { "$value": 0.5, "$description": "Disabled states, medium overlays" },
    "75":  { "$value": 0.75, "$description": "Heavy overlays" },
    "80":  { "$value": 0.8, "$description": "Modal backdrop" },
    "100": { "$value": 1, "$description": "Fully opaque" }
  },

  "zIndex": {
    "$type": "number",
    "$description": "Z-index scale for layering UI elements",
    "base":     { "$value": 0, "$description": "Default stacking context" },
    "dropdown": { "$value": 1000, "$description": "Dropdowns and popovers" },
    "sticky":   { "$value": 1020, "$description": "Sticky headers and navs" },
    "fixed":    { "$value": 1030, "$description": "Fixed position elements" },
    "modal":    { "$value": 1040, "$description": "Modal dialogs" },
    "popover":  { "$value": 1050, "$description": "Popovers above modals" },
    "tooltip":  { "$value": 1060, "$description": "Tooltips (topmost)" }
  },

  "focusRing": {
    "$description": "Focus ring styles for accessibility",
    "width":  { "$type": "dimension", "$value": "2px", "$description": "Focus ring thickness" },
    "offset": { "$type": "dimension", "$value": "2px", "$description": "Gap between element and ring" },
    "color":  { "$type": "color", "$value": "{color.cga.yellow}", "$description": "Focus ring color (accent)" }
  },

  "effects": {
    "$description": "CRT and overlay effect colors. Distinct from effect.* (Tier 4 numeric shader params in effects-params.tokens.json) — these are color tokens consumed by <RetroEffects> CSS via --effects-* CSS vars.",
    "overlay": {
      "$type": "color",
      "$value": "rgba(8, 5, 0, 0.8)",
      "$description": "Modal/dialog backdrop overlay (amber-warm)"
    },
    "scanlineLight": {
      "$type": "color",
      "$value": "rgba(255, 176, 0, 0.05)",
      "$description": "CRT scanline light band"
    },
    "scanlineDark": {
      "$type": "color",
      "$value": "rgba(255, 176, 0, 0.02)",
      "$description": "CRT scanline dark band"
    },
    "vignetteGlow": {
      "$type": "color",
      "$value": "rgba(255, 176, 0, 0.12)",
      "$description": "Inner screen glow vignette"
    },
    "vignetteEdge": {
      "$type": "color",
      "$value": "rgba(8, 5, 0, 0.3)",
      "$description": "Vignette edge darkening (amber-warm)"
    },
    "vignetteCorner": {
      "$type": "color",
      "$value": "rgba(8, 5, 0, 0.5)",
      "$description": "Vignette corner darkening (amber-warm)"
    },
    "screenTint": {
      "$type": "color",
      "$value": "rgba(255, 176, 0, 0.1)",
      "$description": "Subtle amber screen tint"
    },
    "dropShadow": {
      "$type": "color",
      "$value": "rgba(8, 5, 0, 0.5)",
      "$description": "Terminal window drop shadow (amber-warm)"
    },
    "phosphorGlow": {
      "$type": "color",
      "$value": "rgba(255, 176, 0, 0.12)",
      "$description": "Phosphor bloom/bleeding glow for CRT effects"
    },
    "bloomOuter": {
      "$type": "color",
      "$value": "rgba(255, 176, 0, 0.05)",
      "$description": "Outer phosphor bloom layer (faint glow)"
    },
    "bloomCenter": {
      "$type": "color",
      "$value": "rgba(255, 176, 0, 0.03)",
      "$description": "Center phosphor bloom highlight"
    },
    "crtBackground": {
      "$type": "color",
      "$value": "#060300",
      "$description": "Dark warm-black for CRT screen (not pure black)"
    }
  }
}
