{
  "$description": "CGA Amber Theme - Original 16-color CGA palette with amber accents",

  "color": {
    "cga": {
      "$type": "color",
      "$description": "Original CGA 16-color palette restored",
      "black":         { "$value": "#050300", "$description": "Warm near-black (~3% amber)" },
      "blue":          { "$value": "#0000AA" },
      "green":         { "$value": "#00AA00" },
      "cyan":          { "$value": "#00AAAA" },
      "red":           { "$value": "#AA0000" },
      "magenta":       { "$value": "#AA00AA" },
      "brown":         { "$value": "#AA5500" },
      "lightGray":     { "$value": "#ADAAA5", "$description": "Warm light gray (~3% amber)" },
      "darkGray":      { "$value": "#3A3935", "$description": "Warm dark-gray (~3% amber). Darkened from #5A5852 in v0.23 so text-primary (#ADAAA5) passes WCAG AA on bg-secondary surfaces (4.99:1, per scripts/check-contrast.mjs). Disabled-state usage still leverages it; disabled UI is exempt from contrast minimums per WCAG 2.1 SC 1.4.3." },
      "brightBlue":    { "$value": "#5555FF" },
      "brightGreen":   { "$value": "#55FF55" },
      "brightCyan":    { "$value": "#55FFFF" },
      "brightRed":     { "$value": "#FF5555" },
      "brightMagenta": { "$value": "#FF55FF" },
      "yellow":        { "$value": "#FFFF55" },
      "white":         { "$value": "#FFFCF7", "$description": "Warm off-white (~2% amber)" }
    },
    "semantic": {
      "$type": "color",
      "background": {
        "primary":   { "$value": "{color.cga.black}" },
        "secondary": { "$value": "{color.cga.darkGray}" },
        "accent":    { "$value": "{color.cga.blue}" }
      },
      "text": {
        "primary":   { "$value": "{color.cga.lightGray}" },
        "secondary": { "$value": "{color.cga.black}" },
        "accent":    { "$value": "{color.cga.amber}" },
        "disabled":  { "$value": "{color.cga.darkGray}" },
        "muted":     { "$value": "{color.cga.brown}" }
      },
      "border": {
        "default":  { "$value": "{color.cga.lightGray}" },
        "focus":    { "$value": "{color.cga.amber}" },
        "hover":    { "$value": "{color.cga.amberBright}" },
        "disabled": { "$value": "{color.cga.darkGray}" }
      },
      "link": {
        "default": { "$value": "{color.cga.brightCyan}" },
        "hover":   { "$value": "{color.cga.white}" },
        "active":  { "$value": "{color.cga.cyan}" },
        "visited": { "$value": "{color.cga.magenta}" }
      },
      "status": {
        "success": { "$value": "{color.cga.brightGreen}" },
        "warning": { "$value": "{color.cga.yellow}" },
        "error":   { "$value": "{color.cga.brightRed}" },
        "info":    { "$value": "{color.cga.brightCyan}" }
      },
      "alert": {
        "info":    { "$value": "#0A1828" },
        "success": { "$value": "#122010" },
        "warning": { "$value": "#352800" },
        "error":   { "$value": "#430500" }
      }
    }
  }
}
