{
  "$description": "Eidotter Design System - Base Tokens (DTCG Format)",
  "color": {
    "$description": "CGA-authentic 16-color palette plus amber extension",
    "cga": {
      "black": "#000000",
      "blue": "#0000aa",
      "green": "#00aa00",
      "cyan": "#00aaaa",
      "red": "#aa0000",
      "magenta": "#aa00aa",
      "brown": "#aa5500",
      "lightGray": "#aaaaaa",
      "darkGray": "#555555",
      "brightBlue": "#5555ff",
      "brightGreen": "#55ff55",
      "brightCyan": "#55ffff",
      "brightRed": "#ff5555",
      "brightMagenta": "#ff55ff",
      "yellow": "#ffff55",
      "white": "#ffffff",
      "amber": "#ffb000",
      "amberBright": "#fdca9f",
      "amberDim": "#9a5700"
    },
    "semantic": {
      "$description": "Semantic color aliases - override in theme files",
      "background": {
        "primary": "#000000",
        "secondary": "#555555",
        "accent": "#0000aa"
      },
      "text": {
        "primary": "#aaaaaa",
        "secondary": "#ffffff",
        "accent": "#ffff55",
        "disabled": "#555555"
      },
      "border": {
        "default": "#aaaaaa",
        "focus": "#ffff55",
        "hover": "#ffffff",
        "disabled": "#555555"
      },
      "link": {
        "default": "#55ffff",
        "hover": "#ffffff",
        "active": "#00aaaa",
        "visited": "#aa00aa"
      },
      "status": {
        "success": "#55ff55",
        "warning": "#ffff55",
        "error": "#ff5555",
        "info": "#55ffff"
      },
      "alert": {
        "$description": "Alert component background colors",
        "info": "#351201",
        "success": "#0a2015",
        "warning": "#351201",
        "error": "#430000"
      }
    }
  },
  "typography": {
    "fontFamily": {
      "primary": [
        "Perfect DOS VGA 437",
        "Consolas",
        "Monaco",
        "monospace"
      ],
      "fallback": [
        "Consolas",
        "Monaco",
        "Courier New",
        "monospace"
      ]
    },
    "fontSize": {
      "xs": "12px",
      "sm": "14px",
      "base": "16px",
      "lg": "18px",
      "xl": "20px",
      "2xl": "24px",
      "3xl": "30px",
      "4xl": "36px"
    },
    "fontWeight": {
      "regular": 400,
      "semibold": 600,
      "bold": 700
    },
    "lineHeight": {
      "tight": 1.2,
      "normal": 1.5,
      "loose": 1.8
    }
  },
  "spacing": {
    "0": "0px",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px",
    "$description": "8px base grid spacing scale"
  },
  "borderRadius": {
    "$description": "DOS aesthetic: minimal or no rounding",
    "none": "0px",
    "sm": "2px",
    "base": "4px"
  },
  "borderWidth": {
    "thin": "1px",
    "medium": "2px",
    "thick": "4px"
  },
  "shadow": {
    "$description": "DOS-style shadows (typically none or simple offsets)",
    "none": {
      "offsetX": "0px",
      "offsetY": "0px",
      "blur": "0px",
      "spread": "0px",
      "color": "#00000000"
    },
    "drop": {
      "offsetX": "2px",
      "offsetY": "2px",
      "blur": "0px",
      "spread": "0px",
      "color": "#000000"
    },
    "glow": {
      "offsetX": "0px",
      "offsetY": "0px",
      "blur": "8px",
      "spread": "0px",
      "color": "#FFB00080"
    }
  },
  "duration": {
    "$description": "Animation durations - DOS is instant, but allow subtle transitions",
    "instant": "0ms",
    "fast": "100ms",
    "normal": "200ms",
    "slow": "400ms"
  }
}
