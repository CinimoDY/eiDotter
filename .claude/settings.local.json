  ],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "filepath=\"$CLAUDE_FILE_PATH\"; if [[ \"$filepath\" == *.ts || \"$filepath\" == *.tsx ]]; then npx eslint --fix \"$filepath\" 2>/dev/null; fi",
            "statusMessage": "Auto-linting..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "filepath=\"$CLAUDE_FILE_PATH\"; if [[ \"$filepath\" == *tokens.css || \"$filepath\" == *tokens.js || \"$filepath\" == *tokens.json || \"$filepath\" == *tailwind.preset.js || \"$filepath\" == *theme.*.css ]]; then echo 'BLOCKED: This is a generated file. Edit token JSON sources in src/tokens/ and run npm run build-tokens instead.' >&2; exit 1; fi",
            "statusMessage": "Checking generated files..."
          }
        ]
      }
    ]
  },
  "outputStyle": "default"
}
